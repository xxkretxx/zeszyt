{
  "appId": "pl.zeszyt.app",
  "appName": "Zeszyt",
  "webDir": "www",
  "android": {
    "backgroundColor": "#f2f3f5"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon",
      "iconColor": "#2f6bff"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": false
    }
  },
  "ios": {
    "backgroundColor": "#f2f3f5",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  }
}